---
// A screenshot of the app in both themes; home.css shows the one that
// matches the page.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}
const { light, dark, alt, class: className, loading = 'lazy' } = Astro.props;
const widths = [480, 960, 1440, light.width].filter((w) => w <= light.width);
const sizes = `(max-width: 1180px) 100vw, 1120px`;
---

<figure class:list={['shot', className]}>
  <Image class="only-light" src={light} alt={alt} widths={widths} sizes={sizes} loading={loading} />
  <Image class="only-dark" src={dark} alt={alt} widths={widths} sizes={sizes} loading={loading} />
</figure>
