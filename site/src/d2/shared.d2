vars: {
  d2-config: {
    # The dark background matches Starlight's, so diagrams don't sit in a box.
    dark-theme-overrides: {N7: "#17191d"}
  }
}

classes: {
  you: {shape: person}
  browser: {shape: rectangle}
  store: {shape: cylinder}
  external: {shape: cloud}
  files: {shape: page; style.multiple: true}
  focus: {style: {bold: true; stroke-width: 3}}
}
