{
  "name": "bica",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@earendil-works/chord": "^1.4.0",
      "@earendil-works/pi-ai": "^1.4.0",
      "@earendil-works/pi-codemode": "^1.4.0",
      "@earendil-works/pi-durable": "^1.4.0",
      "@solidjs/vite-plugin": "^3.0.0-next.54",
      "@solidjs/web": "^2.0.0-rc.20",
      "@tailwindcss/vite": "^4.3.3",
      "@types/bun": "^1.4.4",
      "@types/node": "^26.6.6",
      "solid-js": "^2.0.0-rc.20",
      "tailwindcss": "^4.3.3",
      "vite": "^8.3.5"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter @bica/server --filter @bica/client dev",
    "dev:site": "bun run --cwd packages/site dev",
    "build": "bun run --cwd packages/client build",
    "build:site": "bun run --cwd packages/site build",
    "deploy:site": "bun run --cwd packages/site deploy",
    "build:bica": "bun run --cwd packages/server build:bica",
    "start": "bun run --cwd packages/server start",
    "test": "bun run --cwd packages/server test",
    "typecheck": "bun run --workspaces typecheck",
    "lint": "oxlint packages",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "checks": "bun run typecheck && bun run lint && bun run fmt:check && bun run test"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.90.0",
    "eslint-plugin-solid": "~0.18.1",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": ">=1.4.3",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
