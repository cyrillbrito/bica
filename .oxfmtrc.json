{
  "singleQuote": true,
  "printWidth": 80,
  "ignorePatterns": [
    "file-routes.d.ts",
    ".agents/skills",
    "docs/explorations/*.html",
    "site/src/content/**/*.mdx"
  ],
  "overrides": [
    {
      "files": ["**/*.md"],
      "options": {
        "proseWrap": "never",
        "printWidth": 1,
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
